VITE_API_URL=http://localhost:5001/api

# Public Cloudinary config. Vite reads client/.env at startup/build time.
# Restart npm run dev / rebuild the deployed client after changing these.
# A dedicated video preset takes precedence; the legacy variable remains valid.
# See docs/video-library.md for required server config and dashboard settings.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=fff_videos_unsigned
VITE_CLOUDINARY_VIDEO_UPLOAD_PRESET=fff_videos_unsigned
