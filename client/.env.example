VITE_API_URL=http://localhost:5001/api

# Video Library / Video Gallery uploads go directly from the admin's browser
# to Cloudinary (never through our server — avoids Vercel serverless upload
# size/timeout limits). Both values below are meant to be public (a cloud
# name and an *unsigned* preset name are not secrets by Cloudinary's own
# design) — but the preset itself should be restricted to video uploads only.
# THIS IS THE FIX for "Video uploads aren't configured yet" in the admin: set
# both values below (in client/.env, not this .example file) and rebuild/restart.
#
# One-time setup in the Cloudinary dashboard (free tier is fine):
#   1. Create a Cloudinary account at cloudinary.com if you don't have one —
#      your cloud name is shown on the dashboard home page after signup.
#   2. Settings (gear icon) -> Upload -> Upload presets -> Add upload preset.
#   3. Signing Mode: Unsigned (required — this app uploads straight from the
#      browser with no server-side secret involved).
#   4. Set "Resource type" to Video (or leave it as "Auto" — either works,
#      since the app always uploads via Cloudinary's /video/upload endpoint,
#      which forces resource_type=video regardless of the preset's own
#      setting; explicitly restricting it to Video here just guards against
#      someone re-using this preset for images by mistake).
#   5. Optionally, under "Upload Manipulations", restrict allowed formats to
#      mp4, webm, mov to match this app's own client-side validation.
#   6. Save, then copy the preset name and your cloud name below.
#
# Do NOT reuse an existing preset that was created specifically for images
# (resource_type explicitly set to "Image") — Cloudinary will reject a video
# upload against it. Either create a second preset as above, or, if your
# existing preset's Resource Type is "Auto", you can reuse it for both.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
