{
  "name": "fluid-fibers-server",
  "private": true,
  "version": "1.0.0",
  "description": "Express + MongoDB API for the Fluid Fibers enquiry and spec-sheet request forms.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "migrate:products": "node src/scripts/migrateProducts.js",
    "migrate:variants": "node src/scripts/migrateProductsToVariants.js",
    "migrate:media": "node src/scripts/migrateImagesToMedia.js",
    "backfill:media": "node src/scripts/backfillMediaData.js",
    "test": "node --test src/__tests__/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
