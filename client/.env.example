VITE_API_URL=http://localhost:5000/api

# Video Gallery uploads go directly from the admin's browser to Cloudinary
# (never through our server — avoids Vercel serverless upload size/timeout
# limits). Both values below are meant to be public (a cloud name and an
# *unsigned* preset name are not secrets by Cloudinary's own design) — but
# the preset itself should be restricted to video uploads only.
#
# One-time setup in the Cloudinary dashboard:
#   1. Settings -> Upload -> Upload presets -> Add upload preset
#   2. Signing Mode: Unsigned
#   3. Restrict allowed formats to video types (mp4, webm, mov)
#   4. Save, then copy the preset name and your cloud name below.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
