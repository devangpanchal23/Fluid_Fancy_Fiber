PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/fluid_fibers
CLIENT_ORIGIN=http://localhost:5173

# Admin auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Used only by `npm run seed:admin` to create/update the single admin account.
# Not read at request time — safe to remove after seeding.
# Quote the value if it contains #, spaces, or other special characters —
# dotenv treats an unquoted # as a comment and will silently truncate it.
# Defaults to admin@gmail.com / admin123 when unset.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD="admin123"
ADMIN_NAME=Admin

# Contact-form/spec-sheet email notifications (optional — if unset, the
# server just skips sending and logs a warning; submissions still save to
# MongoDB either way). Uses Gmail SMTP via an App Password, NOT the regular
# account password: Google Account -> Security -> 2-Step Verification ->
# App passwords.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS="your-16-character-app-password"
# Who receives the notification. Defaults to EMAIL_USER if unset.
NOTIFY_EMAIL=your-gmail-address@gmail.com

# Image uploads (people/category/product photos) are stored as binary data
# directly on their Media document in MongoDB (see imageStorage.js) and
# served back from GET /uploads/:filename — this survives Vercel's
# serverless functions having no persistent/shared filesystem, since nothing
# is written to disk. No extra env vars or third-party account needed for
# images. (Videos still go straight from the browser to Cloudinary — see
# CLOUDINARY_* below and client/.env.example — since video files are far
# larger than the 5MB image cap and shouldn't sit in MongoDB documents.)

# Video uploads (Video Gallery) go straight from the admin's browser to
# Cloudinary (see client/.env.example for the client-side preset config) —
# video bytes never pass through this server. These three are only used
# server-side to delete a video from Cloudinary when it's deleted in the
# admin. Get them from the Cloudinary dashboard (Settings -> Access Keys).
# If unset, deleting a video here still removes it from MongoDB but leaves
# the file on Cloudinary (logged as a warning) — not fatal, just tidy up
# manually in that case.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
