{
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/video-uploads/(.*)", "destination": "/api" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/admin/dashboard", "destination": "/index.html" },
    { "source": "/admin/products", "destination": "/index.html" },
    { "source": "/admin/products/new", "destination": "/index.html" },
    { "source": "/admin/products/:id/edit", "destination": "/index.html" },
    { "source": "/admin/products/:productId/variants", "destination": "/index.html" },
    { "source": "/admin/products/:productId/variants/new", "destination": "/index.html" },
    { "source": "/admin/products/:productId/variants/:id/edit", "destination": "/index.html" },
    { "source": "/admin/media", "destination": "/index.html" },
    { "source": "/admin/categories", "destination": "/index.html" },
    { "source": "/admin/videos", "destination": "/index.html" },
    { "source": "/admin/videos/new", "destination": "/index.html" },
    { "source": "/admin/videos/:id/edit", "destination": "/index.html" },
    { "source": "/admin/video-library", "destination": "/index.html" },
    { "source": "/admin/people", "destination": "/index.html" },
    { "source": "/admin/people/new", "destination": "/index.html" },
    { "source": "/admin/people/:id/edit", "destination": "/index.html" },
    { "source": "/admin/cone-library", "destination": "/index.html" },
    { "source": "/admin/cone-library/new", "destination": "/index.html" },
    { "source": "/admin/cone-library/:id/edit", "destination": "/index.html" },
    { "source": "/admin/enquiries", "destination": "/index.html" },
    { "source": "/admin/settings", "destination": "/index.html" },
    { "source": "/admin/profile", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://vitals.vercel-insights.com https://va.vercel-scripts.com; frame-src https://drive.google.com https://www.google.com" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
